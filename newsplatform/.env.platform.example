# 数据中台（platform）环境变量模板
# 复制为 platform/.env.platform 后填写；.env.platform 不提交版本库
# 前缀 PLATFORM_ 与爬虫 NEWSAGG_ 隔离

# 应用
PLATFORM_ENV=production
PLATFORM_DEBUG=false

# 数据库（compose 内默认服务名 mysql；本地跑则改 127.0.0.1）
PLATFORM_DB_HOST=mysql
PLATFORM_DB_PORT=3306
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform_dev_pwd
PLATFORM_DB_NAME=newsagg_platform

# Redis（compose 内默认服务名 redis）
PLATFORM_REDIS_URL=redis://redis:6379/0

# MySQL root（仅 mysql 容器初始化用）
MYSQL_ROOT_PASSWORD=root_dev_pwd

# JWT（生产务必改为强随机值）
PLATFORM_JWT_SECRET=change-me-in-production

# 限流
PLATFORM_RATE_LIMIT_DEFAULT=120/minute
PLATFORM_RATE_LIMIT_AUTH=10/minute

# 对外端口
FASTAPI_PORT=8000
FLASK_PORT=5000
